rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /memos/{memoId} {
      // 메모 읽기 및 삭제 허용
      allow read, delete: if true;

      // 5글자 이상 입력 시 저장되지 않도록 제한 (5글자 미만인 1~4글자만 저장 허용)
      // 만약 "5글자 이하 허용(6글자 이상 차단)"을 원하시면 <= 5 로 수정하실 수 있습니다.
      allow create, update: if request.resource.data.text is string
                            && request.resource.data.text.size() < 5;
    }
  }
}
